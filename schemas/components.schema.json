{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/ravvdevv/brutal-kit/blob/main/schemas/components.schema.json",
  "title":"BrutalKit component manifest",
  "type":"object",
  "required":["$schema","schemaVersion","library","components"],
  "additionalProperties":false,
  "properties":{
    "$schema":{"type":"string"},
    "schemaVersion":{"const":1},
    "library":{
      "type":"object",
      "required":["name","version","styleEntry","styleSource","scriptEntry","scriptIsOptional","classPrefix","tokenPrefix"],
      "additionalProperties":false,
      "properties":{
        "name":{"const":"BrutalKit"},"version":{"type":"string"},
        "styleEntry":{"type":"string"},"styleSource":{"type":"string"},"scriptEntry":{"type":"string"},
        "scriptIsOptional":{"type":"boolean"},"classPrefix":{"const":"bk-"},"tokenPrefix":{"const":"--bk-"}
      }
    },
    "components":{
      "type":"array","minItems":1,
      "items":{
        "type":"object",
        "required":["id","name","category","classes","requiresJavaScript","semantics"],
        "additionalProperties":false,
        "properties":{
          "id":{"type":"string","pattern":"^[a-z0-9-]+$"},"name":{"type":"string"},"category":{"type":"string"},
          "classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^bk-"}},
          "requiresJavaScript":{"type":"boolean"},
          "dataAttributes":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^data-bk-"}},
          "entryPoint":{"type":"string"},"semantics":{"type":"string"},
          "accessibility":{"type":"array","items":{"type":"string"}},
          "keyboard":{"type":"array","items":{"type":"string"}},
          "markupContract":{"type":"array","items":{"type":"string"}}
        },
        "allOf":[{"if":{"properties":{"requiresJavaScript":{"const":true}}},"then":{"required":["entryPoint"]}}]
      }
    }
  }
}
